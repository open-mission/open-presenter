{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Presenter",
  "version": "0.3.0",
  "identifier": "dev.openpresenter.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Presenter",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Apresentação para igrejas e eventos",
    "longDescription": "Software desktop open source e leve para apresentação em igrejas e eventos: setlists, projeção e saídas multi-tela."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMTRDN0UyRjBCODMxNzIKUldSeU1ianc0c2NVRFhDQThwSHc5amtZYU1qYXA2YWJFMU9uQkZ1eUJlOFBVVGR0MGM0b0lNY1YK",
      "endpoints": [
        "https://github.com/open-mission/open-presenter/releases/latest/download/latest.json"
      ]
    }
  }
}
