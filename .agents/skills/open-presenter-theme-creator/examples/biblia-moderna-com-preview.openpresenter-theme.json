        "css": {
          "top": "16%",
          "left": "8%",
          "width": "84%",
          "height": "66%",
          "textAlign": "center",
          "fontSize": "52px",
          "fontWeight": "600",
          "lineHeight": "1.35",
          "color": "#ffffff",
          "textShadow": "0 2px 14px rgba(0,0,0,0.9)",
