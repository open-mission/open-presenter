{
  "$schema": "https://openpresenter.dev/schemas/theme-v1.json",
  "format": "open-presenter-theme",
  "version": 1,
  "exportedAt": "2026-10-19T13:25:00.000Z",
  "theme": {
    "title": "Bíblia Moderna com Próximo Versículo",
    "category": "theme",
    "css": {
      "background": "radial-gradient(circle at 50% 120%, #1e1b4b 0%, #09090b 60%, #000000 100%)"
