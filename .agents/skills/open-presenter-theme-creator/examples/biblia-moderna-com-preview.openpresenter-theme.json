          "top": "6%",
          "left": "8%",
          "width": "84%",
          "height": "8%",
          "textAlign": "center",
          "fontSize": "30px",
          "fontWeight": "700",
          "letterSpacing": "3px",
          "textTransform": "uppercase",
          "color": "#38bdf8",
          "textShadow": "0 2px 8px rgba(0,0,0,0.8)"
        }
      },
      {
        "id": "versiculo",
        "type": "TEXT",
        "x": 8,
        "y": 16,
        "visible": true,
        "locked": false,
