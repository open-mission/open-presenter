{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenPresenterThemePackage",
  "description": "Formato de arquivo JSON (.openpresenter-theme.json) para temas do Open Presenter",
  "type": "object",
  "required": ["format", "version", "theme"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": ["open-presenter-theme"]
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "theme": {
      "$ref": "#/definitions/SlideTheme"
    }
  },
  "definitions": {
    "SlideTheme": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "guid": {
          "type": "string",
          "description": "UUID v4 único. O importador gera um novo se omitido ou na importação padrão."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Nome do tema visível na galeria e no seletor."
        },
        "category": {
          "type": "string",
          "enum": ["theme", "stage", "presentation"],
          "default": "theme",
          "description": "'theme' para projeção pública (telão/livestream) ou 'stage' para monitor de retorno."
        },
        "css": {
          "type": "object",
          "description": "Estilos CSS do container principal (fundo 16:9). Ex: background, backgroundColor.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "elements": {
          "type": "array",
          "description": "Camadas do layout único (stage/presentation) e de temas v1. Quando 'pages' existe, o topo é ignorado.",
          "items": {
            "$ref": "#/definitions/ThemeElement"
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "description": "Páginas por contexto. Presente em temas públicos v2.",
          "items": {
            "$ref": "#/definitions/ThemePage"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "ThemeContext": {
      "type": "string",
      "enum": ["music", "bible", "text"]
    },
    "ThemePage": {
      "type": "object",
      "required": ["context", "css", "elements"],
      "properties": {
        "id": {
          "type": "string",
          "description": "UUID da página; gerado na importação se omitido."
        },
        "context": {
          "$ref": "#/definitions/ThemeContext"
        },
        "css": {
          "type": "object",
          "description": "Fundo e estilos da página.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "elements": {
          "type": "array",
          "description": "Camadas da página. Pode ser vazio (página em branco).",
          "items": {
            "$ref": "#/definitions/ThemeElement"
          }
        }
      }
    },
    "ThemeElement": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único do elemento dentro do tema (ex: 'titulo', 'verso', 'relogio')."
        },
        "name": {
          "type": "string",
          "description": "Nome cosmético da camada no editor. O id continua sendo a chave."
        },
        "type": {
          "type": "string",
          "enum": ["TEXT", "IMAGE", "VIDEO", "RECTANGLE"]
        },
        "x": {
          "type": "number",
          "description": "Posição horizontal base em porcentagem (0 a 100)."
        },
        "y": {
          "type": "number",
          "description": "Posição vertical base em porcentagem (0 a 100)."
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "locked": {
          "type": "boolean",
          "default": false
        },
        "text": {
          "type": "string",
          "description": "Texto do elemento. Pode conter variáveis dinâmicas no formato {variavel} e tags HTML seguras (<span>, <b>, <br>)."
        },
        "src": {
          "type": "string",
          "description": "URL ou caminho do recurso de mídia (para IMAGE ou VIDEO)."
        },
        "fill": {
          "type": "string",
          "description": "Cor de preenchimento (para RECTANGLE)."
        },
        "url": {
          "type": "string",
          "description": "URL alternativa para recursos remotos."
        },
        "assetTypeVisibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["music", "bible", "text"]
          },
          "description": "Filtro opcional para exibir o elemento somente quando o tipo de slide coincidir."
        },
        "css": {
          "type": "object",
          "description": "Propriedades CSS inline aplicadas ao elemento.",
          "properties": {
            "top": { "type": "string" },
            "left": { "type": "string" },
            "width": { "type": "string" },
            "height": { "type": "string" },
            "color": { "type": "string" },
            "fontSize": { "type": "string" },
            "fontFamily": { "type": "string" },
            "fontWeight": { "type": "string" },
            "textAlign": { "type": "string", "enum": ["left", "center", "right", "justify"] },
            "lineHeight": { "type": "string" },
            "letterSpacing": { "type": "string" },
            "textTransform": { "type": "string", "enum": ["none", "uppercase", "lowercase", "capitalize"] },
            "textShadow": { "type": "string" },
            "whiteSpace": { "type": "string" },
            "autoShrink": { "type": "string", "enum": ["true", "false"] },
            "autoFit": { "type": "string", "enum": ["true", "false"] },
            "background": { "type": "string" },
            "backgroundColor": { "type": "string" },
            "borderRadius": { "type": "string" },
            "opacity": { "type": "string" },
            "zIndex": { "type": "string" }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
